<style>
  .notify-wrapper {
  text-align: center;
  margin-top: 1rem;
}

.notify-me-form {
  display: flex;
  gap: 2px;
  align-items: stretch;
  max-width: 420px;
  margin: 0 auto;
}

.notify-label {
  display: block;
  font-weight: 600;
  margin-bottom: 8px;
  font-size: 14px;
}

.notify-input {
  padding: 10px;
  font-size: 14px;
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
  border: 1px solid #000;
  text-align: left;
  box-sizing: border-box;
}

.notify-button {
  background-color: #000;
  color: #fff;
  padding: 10px 20px;
  border: 1px solid #000;
  font-size: 14px;
  text-transform: uppercase;
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
}

@media (max-width: 400px) {
  .notify-button {
    padding: 10px 12px;
    font-size: 12px;
  }
}

.notify-success {
  display: none;
  font-size: 18px;
  margin-top: 12px;
}

/* Colored variant buttons — background matches the color name, white text on top */
.option-value--color {
  color: #fff !important;
  border: 1px solid transparent !important;
  padding: 8px 16px !important;
}
.option-value--color.active {
  outline: 2px solid #000;
  outline-offset: 2px;
}
.option-value--color.color-pink   { background: #E88BA0; }
.option-value--color.color-blue   { background: #1E4FA8; }
.option-value--color.color-black  { background: #000000; }
.option-value--color.color-white  { background: #FFFFFF; color: #000 !important; border-color: #ccc !important; }
.option-value--color.color-green  { background: #3F6B3E; }
.option-value--color.color-grey,
.option-value--color.color-gray   { background: #B5B5B5; }

/* Per-product overrides: Warehouse Cargo Pants keep the darker charcoal gray */
.page-width[data-product-handle*="warehouse-cargo"] .option-value--color.color-gray,
.page-width[data-product-handle*="warehouse-cargo"] .option-value--color.color-grey {
  background: #7A7A7A;
}
.option-value--color.color-navy   { background: #3B5998; }
.option-value--color.color-red    { background: #C0322B; }
.option-value--color.color-yellow { background: #EFC94C; color: #000 !important; }
.option-value--color.color-orange { background: #E77A2B; }
.option-value--color.color-purple { background: #6C4B8E; }
.option-value--color.color-brown  { background: #6E4B2E; }
.option-value--color.color-beige  { background: #D8C7A0; color: #000 !important; }

{% if settings.image-switches == 'black' %}
.cursor-right {
  cursor: url('{{ 'arrow-right.svg' | asset_url | image_url: '32x32' }}'), auto;
}
.cursor-left {
  cursor: url('{{ 'arrow-left.svg' | asset_url | image_url: '32x32' }}'), auto;
}
{% elsif settings.image-switches == 'white' %}
.cursor-right { 
  cursor: url('{{ 'arrow-right-white.svg' | asset_url | image_url: '32x32' }}'), auto;
}
.cursor-left {
  cursor: url('{{ 'arrow-left-white.svg' | asset_url | image_url: '32x32' }}'), auto;
}
{% endif %}
.figureImg {
  display: flex;
  align-items: center;
  overflow: hidden;
}
.product__item-img, .product__item-video {
  min-width: 100%;
  height: auto;
  padding: 1px;
}
.image-navigation{
  display: none;
}
/* Show pair-navigation arrows/dots on desktop below the image pair */
@media screen and (min-width: 750px) {
  .image-navigation.has-multiple-pairs {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    grid-column: 1 / -1; /* span both columns of the pair grid */
  }
  .image-navigation.has-multiple-pairs .nav-arrow {
    cursor: pointer;
    padding: 6px 8px;
    font-size: 22px;
    line-height: 1;
  }
  .image-navigation.has-multiple-pairs .nav-dots {
    display: flex;
    gap: 8px;
  }
  .image-navigation.has-multiple-pairs .nav-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ddd;
    cursor: pointer;
  }
  .image-navigation.has-multiple-pairs .nav-dot.active {
    background: #000;
  }
}
{% if product.images.size < 2 %}
  .product__item-img {
    cursor: inherit;
}
{% endif %}

@media screen and (max-width: 749px){
/* .figureImg is a flex row holding every product image. Left in normal flow the
   dots/arrows row became a flex sibling of the photos and was laid out past the
   last one, then clipped away by overflow:hidden. Pinning it to the bottom of
   the gallery takes it out of that row so it renders where it belongs. */
.image-navigation {
  display: flex;
  justify-content: center;
  align-items: center;
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
}

.nav-arrow {
  cursor: pointer;
  padding: 10px 0;
  font-size: 20px;
}

.nav-dots {
  display: flex;
  gap: 5px;
}

.nav-dot {
  width: 10px;
  height: 10px;
  background-color: {{ settings.product_dot_bg }};
  border: 1px solid {{ settings.product_dot_active }};
  border-radius: 50%;
  cursor: pointer;
  position: relative;
}

/* Invisible tap target so a thumb can hit a 10px dot. Clicks on the pseudo
   element still count as clicks on the dot itself. */
.nav-dot::after {
  content: '';
  position: absolute;
  inset: -12px;
}

.nav-dot.active {
  background-color: {{ settings.product_dot_active }};
}
.nav-arrow img {
    width: 20px;
    height: 20px;
    display: block;
    margin: 0px 15px;
}
.figureImg {
    width: 100% !important;
    position: relative;
    {% if product.images.size > 1 or product.media.size > 1 %}
    /* Reserve a band at the bottom for the pinned dots/arrows row. */
    padding-bottom: 2.75rem !important;
    {% else %}
    padding-bottom: 1.5rem !important;
    {% endif %}
}
}
/* ── Size option hover ── */
.option-value:not(.disabled):not(.active):hover {
  border: 1px solid #000;
}

/* ── Gallery browse overlays (desktop only) ── */
.gallery-overlay-left,
.gallery-overlay-right {
  display: none;
}

@media screen and (min-width: 749px) {
  .gallery-overlay-left,
  .gallery-overlay-right {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    display: flex;
    align-items: center;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
    z-index: 6;
  }

  .gallery-overlay-left {
    left: 0;
    justify-content: flex-start;
    padding-left: 1.25rem;
  }

  .gallery-overlay-right {
    right: 0;
    justify-content: flex-end;
    padding-right: 1.25rem;
  }

  .gallery-overlay-left span,
  .gallery-overlay-right span {
    color: #000;
    font-size: 28px;
    font-weight: 300;
    line-height: 1;
  }

.figureImg:hover .gallery-overlay-left,
  .figureImg:hover .gallery-overlay-right {
    opacity: 1;
  }
}

/* ── Notify submit button ── */
.notify-submit-btn {
  background-color: #000;
  color: #fff;
  padding: 10px 20px;
  border: none;
  cursor: pointer;
  text-transform: uppercase;
  font-size: 14px;
  letter-spacing: 0.5px;
  transition: opacity 0.2s ease;
}

.notify-submit-btn:hover {
  opacity: 0.7;
}

#AddToCartForm{
  width: 100%;
}
.product-table{
  max-width: 100%;
  overflow: scroll;
}

@media screen and (min-width: 749px){
  .product-info {
    margin-top: 0 !important;
}
  .figureImg {
    position: relative;
}
  .product__item-img, .product__item-video {
    max-height: 100%;
    max-width: 100%;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: inherit !important;
    {% unless product.images.size == 1 %}
    opacity: 0; 
    {% endunless %}
  }

  .product__item-img.active, .product__item-video.active {
    opacity: 1; 
  }
  .product__item-video{
    z-index: -1;
  }
  .product__item-img{
    z-index: 1;
  }
}

/* ── Product page redesign (desktop only) ── */
@media screen and (min-width: 750px) {

  /* Wrapper — fills viewport height minus header + sticky footer, vertically centers content */
  .product-page-inner {
    min-height: calc(100vh - var(--product-header-h, 120px) - var(--product-footer-h, 100px));
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4vh;
    padding: 3vh 0;
    box-sizing: border-box;
  }

  /* Title in its own container, 42px, one line via JS auto-fit */
  .product-title-container {
    margin: 8vh 0 0;
    text-align: center;
  }
  .product-info__title--above {
    font-size: 42px;
    line-height: 1.15em;
    margin: 0 auto;
    padding: 0;
    max-width: 100%;
    text-align: center;
    white-space: nowrap;
  }

  /* 25 / 50 / 25 columns — center all three so text sits vertically balanced with the tee image */
  .product-info {
    display: flex;
    align-items: center;
  }
  .product-info__pc {
    width: 25%;
    padding-right: 24px;
    padding-bottom: 9vh;
    box-sizing: border-box;
  }
  .figureImg {
    width: 50% !important;
    box-sizing: border-box;
    padding: 0 12px;
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: center;
    justify-items: center;
  }
  .figureImg--single {
    grid-template-columns: 1fr;
  }
  .product-info__main {
    width: 25%;
    padding-left: 24px !important;
    padding-top: 0 !important;
    padding-bottom: 9vh !important;
    box-sizing: border-box;
  }

  /* Photos inside the 50% column — grid children, only two active */
  .figureImg .product__item-img,
  .figureImg .product__item-video {
    display: none !important;
    position: static !important;
    transform: none !important;
    opacity: 1 !important;
    max-height: none !important;
    max-width: 100% !important;
    width: 100% !important;
    height: auto !important;
  }
  .figureImg .product__item-img.active,
  .figureImg .product__item-img.active-pair,
  .figureImg .product__item-video.active,
  .figureImg .product__item-video.active-pair {
    display: block !important;
  }

  /* Single-image variant: image centered and slightly larger */
  .figureImg--single .product__item-img.active {
    max-width: 80% !important;
    margin: 0 auto;
  }

  /* Hide the old side-overlay gallery arrows (image-clickable navigation) */
  .gallery-overlay-left,
  .gallery-overlay-right {
    display: none !important;
  }
}

/* ── Lightbox / zoom overlay ── */
.product-lightbox {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.92);
  z-index: 9999;
  display: none;
  align-items: center;
  justify-content: center;
  cursor: zoom-out;
  overflow: auto;
  padding: 40px;
  box-sizing: border-box;
}
.product-lightbox.is-open {
  display: flex;
}
.product-lightbox__close {
  position: fixed;
  top: 20px;
  right: 20px;
  width: 44px;
  height: 44px;
  font-size: 32px;
  line-height: 1;
  background: transparent;
  border: none;
  color: #fff;
  cursor: pointer;
  z-index: 10000;
  padding: 0;
}
.product-lightbox__close:hover {
  opacity: 0.7;
}
.product-lightbox__image {
  display: block;
  max-width: 90vw;
  max-height: 90vh;
  width: auto;
  height: auto;
  cursor: zoom-in;
  transition: transform 0.2s ease;
}
.product-lightbox__image.is-zoomed {
  max-width: none;
  max-height: none;
  transform: scale(1);
  cursor: zoom-out;
}
/* Show the zoom-in cursor when hovering images in the main gallery */
.figureImg .product__item-img {
  cursor: zoom-in;
}

/* Mobile — bring the title closer to the product photo, keep it centered */
@media screen and (max-width: 749px) {
  .product-title-container {
    text-align: center;
    margin: 2vh auto 0;
    padding: 0;
    width: 100%;
  }
  .product-info__title--above {
    margin: 0 auto !important;
    padding: 0;
    line-height: 1.2em;
    text-align: center !important;
    /* nowrap and the full container width let the auto-fit script size the title
       the way it already does on desktop. Without nowrap the text would wrap to
       two lines instead of shrinking, and the script's width test never fires. */
    white-space: nowrap;
    max-width: 100% !important;
    display: block !important;
  }
  .product-info {
    margin-top: 8px !important;
    margin-bottom: 20px !important;
  }
  .figureImg {
    margin-top: 0 !important;
  }

  /* The desktop left column has no visible content on mobile (its description is
     display:none in main.css) but kept a 2rem top padding, leaving a 32px empty
     band that pushed the photo away from the title. */
  .product-info__pc {
    padding-top: 0 !important;
  }

  /* main.css keeps padding-left: 24px on .product-info__main and its mobile rule
     overrides only the width, so everything under the photo (swatches, sizes,
     add-to-cart, description) sat 12px right of center. */
  .product-info__main {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
}
</style>

<div class="page-width" data-product-handle="{{ product.handle }}">
  {% assign current_variant = product.selected_or_first_available_variant %}
  {% assign featured_image = current_variant.featured_image | default: product.featured_image %}

  <div class="product-page-inner">
  <div class="product-title-container">
    <h2 class="product-info__title product-info__title-top product-info__title--above">{{ product.title }}</h2>
  </div>

  <div class="product-info">

    <div class="product-info__pc">
      {% for block in section.blocks %}
          {% case block.type %}

         {% when 'item-type' %} 
            <div class="product-block-content item-type">
              <h2>
                {% if block.settings.item-type == 'pre-made' %}
                  Pre-made
                {% else %}
                  Pre-order
                {% endif %}
              </h2>
            </div>
          {% endcase %}
      {% endfor %}
      <div class="product-info__description-pc">{{ product.description }}</div>
    </div>
  
    <div class="figureImg fade-in" id="gallery">
      {% if product.images.size > 1 %}
        <div class="gallery-overlay-left"><span>←</span></div>
        <div class="gallery-overlay-right"><span>→</span></div>
      {% endif %}
      {% for image in product.images %}
      <img class="product__item-img" data-image-id="{{ image.id }}" src="{{ image | img_url: 'master' }}" alt="{{ image.alt | escape }}">
      {% endfor %}

      {% for media in product.media %}
      {% if media.media_type == 'video' %}
      <video class="product__item-video" controls>
        <source src={{ media | video_tag: controls: true }}
      </video>
      {% endif %}
      {% endfor %}

    {% if product.images.size > 1 or product.media.size > 1 %}
    <div class="image-navigation" id="image-navigation">
      <span class="nav-arrow mobile-cursor-left" id="prev-arrow">
        <img src="
          {% if settings.image-switches == 'black' %}{{ 'arrow-left.svg' | asset_url | image_url: '32x32' }} {% elsif settings.image-switches == 'white' %}{{ 'arrow-left-white.svg' | asset_url | image_url: '32x32' }} {% endif %}
        ">
      </span>
      <div class="nav-dots" id="nav-dots"></div>
      <span class="nav-arrow mobile-cursor-right" id="next-arrow">
        <img src="
          {% if settings.image-switches == 'black' %}{{ 'arrow-right.svg' | asset_url | image_url: '32x32' }} {% elsif settings.image-switches == 'white' %}{{ 'arrow-right-white.svg' | asset_url | image_url: '32x32' }} {% endif %}
        ">
      </span>
    </div>
    {% endif %}
    </div>
  
    <div class='product-info__main'>
      <form action="/cart/add" method="post" enctype="multipart/form-data" id="AddToCartForm">
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        
        <div class='product-info__parent'>
          <div class='product-info__form'>
            {% for block in section.blocks %}
              {% case block.type %}
                 {%- when '@app' -%}
                  {%- render block -%}                
                 {% when 'variant-selector' %}
                  {% if product.variants.size > 1 %}
                    {% for option in product.options_with_values %}
                      {%- assign opt_name = option.name | downcase -%}
                      {%- assign is_color = false -%}
                      {%- if opt_name == 'color' or opt_name == 'colour' -%}{%- assign is_color = true -%}{%- endif -%}
                      <div class="product-options">
                        <div class="option-values">
                          {% for value in option.values %}
                            <button type="button" class="option-value{% if is_color %} option-value--color color-{{ value | handleize }}{% endif %}" data-option="{{ option.position }}" data-value="{{ value | escape }}">
                              {{ value }}
                            </button>
                          {% endfor %}
                        </div>
                      </div>
                    {% endfor %}
                    {% endif %}
                  {% when 'buy-buttons' %}

                
                
                
                {% if current_variant.available %}
  <button class='product-info__cart-btn button' type="submit">ADD TO CART — {{ current_variant.price | money }}</button>
{% else %}
  <button class='product-info__cart-btn button' id="soldout" type="button" disabled>Sold Out</button>
{% endif %}

<!-- END OF ADD TO CART FORM -->
</form> <!-- ← closing tag for #AddToCartForm -->

<!-- Notify Me Form for Sold Out Products -->
{% unless current_variant.available %}
  <div class="notify-wrapper">
    <label for="notify-email" class="notify-label">NOTIFY WHEN RESTOCKED</label>
    <form method="post" action="/contact#notify" accept-charset="UTF-8" class="notify-me-form">
      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="contact[tags]" value="restock request: {{ product.title }}">

      <input type="email" name="contact[email]" id="notify-email" placeholder="Enter your email" required class="notify-input">
      <button type="submit" class="notify-submit-btn notify-button">SUBMIT</button>
    </form>

    <div id="notify-success" style="display: none; margin-top: 10px; font-size: 18px;">✅</div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const urlParams = new URLSearchParams(window.location.search);
      const posted = urlParams.get("customer_posted");
      const anchor = window.location.hash;

      if (posted === "true" && anchor === "#notify") {
        const message = document.getElementById("notify-success");
        if (message) {
          message.style.display = "block";
          message.scrollIntoView({ behavior: "smooth" });
        }
      }
    });
  </script>
{% endunless %}




                    {% if block.settings.enable_dynamic_checkout %}
                      {%- form 'product', product -%}
                        {% comment %}
                          Automatically inserted by Shop Pay Installments theme updater
                        {% endcomment %}
                        {% unless settings.disable_autogenerated_payment_terms %}
                          {{ form | payment_terms }}
                        {% endunless %}
                       {{ form | payment_button }}
                      {% endform %}
                    {% endif %}
                  {% when 'content' %} 
                  <div class="product-block-content">
                    <p>{{- block.settings.content -}}</p>
                  </div>
              {% endcase %}
            {% endfor %}
            
            
            

            
          </div>
              
        </div>

        
        <div class='product-info__description-mobile'>{{ product.description }}</div>
      </form>

    </div>
  </div>
  </div>
</div>

<div id="product-lightbox" class="product-lightbox" role="dialog" aria-hidden="true" aria-label="Product image zoom">
  <button type="button" class="product-lightbox__close" aria-label="Close">&times;</button>
  <img class="product-lightbox__image" src="" alt="">
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // ── Lightbox ──
  var lightbox = document.getElementById('product-lightbox');
  var lightboxImg = lightbox ? lightbox.querySelector('.product-lightbox__image') : null;
  var lightboxClose = lightbox ? lightbox.querySelector('.product-lightbox__close') : null;

  function openLightbox(src, alt) {
    if (!lightbox || !src) return;
    lightboxImg.src = src;
    lightboxImg.alt = alt || '';
    lightboxImg.classList.remove('is-zoomed');
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    lightboxImg.classList.remove('is-zoomed');
    document.body.style.overflow = '';
  }
  if (lightbox) {
    // Click overlay (not on image or close) closes
    lightbox.addEventListener('click', function(e) {
      if (e.target === lightbox) closeLightbox();
    });
    // Close button
    if (lightboxClose) lightboxClose.addEventListener('click', function(e) {
      e.stopPropagation();
      closeLightbox();
    });
    // Clicking the image inside toggles a further magnified zoom
    if (lightboxImg) lightboxImg.addEventListener('click', function(e) {
      e.stopPropagation();
      lightboxImg.classList.toggle('is-zoomed');
    });
    // ESC to close
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && lightbox.classList.contains('is-open')) closeLightbox();
    });
  }

  const gallery = document.getElementById('gallery');
  const rawItems = Array.from(gallery.querySelectorAll('.product__item-img, .product__item-video'));
  const prevArrow = document.getElementById('prev-arrow');
  const nextArrow = document.getElementById('next-arrow');
  const navDotsContainer = document.getElementById('nav-dots');
  let currentIndex = 0;

  const productVariants = {{ product.variants | json }};
  let currentVariant = {{ product.selected_or_first_available_variant | json }};

  // Reorder gallery items so pair navigation follows the SWATCH ORDER, not the Shopify media order.
  // Each image gets a color rank from the closest previous variant featured_image;
  // JS Array.sort is stable, so back-view images stay with their front-view.
  const productOptions = {{ product.options_with_values | json }};
  let colorOptionPosition = 0;
  let colorOrder = [];
  productOptions.forEach(function(opt) {
    var name = (opt.name || '').toLowerCase();
    if (name === 'color' || name === 'colour') {
      colorOptionPosition = opt.position;
      colorOrder = opt.values;
    }
  });

  let items;
  if (colorOptionPosition > 0 && colorOrder.length > 1) {
    var currentRank = Infinity;
    var ranked = rawItems.map(function(item) {
      var itemId = item.getAttribute('data-image-id');
      var variant = productVariants.find(function(v) {
        return v.featured_image && String(v.featured_image.id) === itemId;
      });
      if (variant) {
        var colorVal = variant['option' + colorOptionPosition];
        var rank = colorOrder.indexOf(colorVal);
        if (rank >= 0) currentRank = rank;
      }
      return { item: item, rank: currentRank };
    });
    ranked.sort(function(a, b) { return a.rank - b.rank; });
    // Remember each image's color so back views, which are no variant's featured
    // image, can still tell the swatches which color is on screen.
    ranked.forEach(function(r) {
      if (r.rank !== Infinity) r.item.dataset.colorRank = r.rank;
    });
    items = ranked.map(function(r) { return r.item; });
  } else {
    items = rawItems;
  }
  
  function scrollToVariantMedia(selectedVariant) {
    const variantImage = selectedVariant.featured_image;
    if (!variantImage) return;
    const targetId = String(variantImage.id);
    const variantMediaIndex = [...items].findIndex(item =>
      item.tagName === 'IMG' && item.getAttribute('data-image-id') === targetId
    );
    if (variantMediaIndex !== -1 && variantMediaIndex !== currentIndex) {
      currentIndex = variantMediaIndex;
      updateMediaPosition();
    }
  }

  // When the user arrows/dots/swipes through images, sync the active variant swatch
  // to whichever variant owns the current image. Clicks the color button so
  // selectedOptions, price, and cart-button ID all stay consistent.
  function syncSwatchToCurrentImage() {
    var currentItem = items[currentIndex];
    if (!currentItem) return;
    var currentImgId = currentItem.getAttribute('data-image-id');
    var matchingVariant = currentImgId && productVariants.find(function(v) {
      return v.featured_image && String(v.featured_image.id) === currentImgId;
    });

    var targetColor = null;
    if (matchingVariant) {
      targetColor = matchingVariant['option' + colorOptionPosition];
    } else if (currentItem.dataset.colorRank !== undefined) {
      // Back views are no variant's featured image, so fall back to the color
      // worked out when the gallery was reordered. Without this the swatch keeps
      // the previously selected color and can disagree with the photo on screen,
      // which would let someone add the wrong color to their cart.
      targetColor = colorOrder[Number(currentItem.dataset.colorRank)];
    }
    if (!targetColor) return;

    var colorButtons = document.querySelectorAll('.option-value--color');
    for (var i = 0; i < colorButtons.length; i++) {
      var btn = colorButtons[i];
      if (btn.getAttribute('data-value') === targetColor && !btn.classList.contains('active')) {
        btn.click();
        break;
      }
    }
  }

function updateMediaPosition() {
  if (items.length > 1) {
    if (window.matchMedia('(min-width: 749px)').matches) {
      // Desktop: show two images at a time (current pair)
      var pairIndex = Math.floor(currentIndex / 2);
      var firstOfPair = pairIndex * 2;
      var secondOfPair = firstOfPair + 1;
      items.forEach((item, index) => {
        item.classList.remove('active', 'active-pair');
        if (index === firstOfPair) {
          item.classList.add('active');
          item.classList.add('fade-in');
          setTimeout(() => item.classList.remove('fade-in'), 300);
          if (item.tagName === 'VIDEO') item.play();
        } else if (index === secondOfPair) {
          item.classList.add('active-pair');
          item.classList.add('fade-in');
          setTimeout(() => item.classList.remove('fade-in'), 300);
          if (item.tagName === 'VIDEO') item.play();
        } else {
          if (item.tagName === 'VIDEO') {
            item.pause();
            item.currentTime = 0;
          }
        }
      });
      // Toggle single-image styling if the pair has only one item
      if (secondOfPair >= items.length) {
        gallery.classList.add('figureImg--single');
      } else {
        gallery.classList.remove('figureImg--single');
      }
      updateCursor(items[currentIndex]);
    } else {
      const offset = currentIndex * -100;
      items.forEach(item => {
        item.style.transform = `translateX(${offset}%)`;
        item.style.transition = isTouchDevice() ? 'transform 0.25s ease' : 'none';
      });
      if (!isTouchDevice()) {
        items[currentIndex].classList.add('fade-in');
        setTimeout(() => {
          items[currentIndex].classList.remove('fade-in');
        }, 300);
      }
      updateCursor(items[currentIndex]);
    }
    updateDots();
  } else if (items.length === 1) {
    items[0].classList.add('active');
    items[0].classList.add('fade-in');
    setTimeout(() => {
      items[0].classList.remove('fade-in');
    }, 300);
    if (items[0].tagName === 'VIDEO') {
      items[0].play();
    }
    // Single image — collapse grid so it centers and fills the space
    gallery.classList.add('figureImg--single');
  }
  // Keep the color swatch in sync with the currently-visible image
  syncSwatchToCurrentImage();
}

  // Step size — 2 on desktop (pairs), 1 on mobile (single image)
  function step() {
    return window.matchMedia('(min-width: 749px)').matches ? 2 : 1;
  }

  function updateDots() {
    const dots = navDotsContainer.querySelectorAll('.nav-dot');
    const activeGroup = Math.floor(currentIndex / step());
    dots.forEach((dot, index) => {
      dot.classList.toggle('active', index === activeGroup);
    });
  }

  function createDots() {
    // Desktop: one dot per pair. Mobile: one dot per image.
    navDotsContainer.innerHTML = '';
    const s = step();
    const dotCount = Math.ceil(items.length / s);
    for (let i = 0; i < dotCount; i++) {
      const dot = document.createElement('div');
      dot.classList.add('nav-dot');
      if (i === Math.floor(currentIndex / s)) dot.classList.add('active');
      dot.addEventListener('click', () => {
        currentIndex = i * s;
        updateMediaPosition();
      });
      navDotsContainer.appendChild(dot);
    }
  }

  function handleSwipe(direction) {
    const s = step();
    if (direction === 'left') {
      currentIndex = (currentIndex + s) % items.length;
    } else if (direction === 'right') {
      currentIndex = (currentIndex - s + items.length) % items.length;
    }
    updateMediaPosition();
  }

  function handleArrowClick(direction) {
    const s = step();
    if (direction === 'left') {
      currentIndex = (currentIndex - s + items.length) % items.length;
    } else if (direction === 'right') {
      currentIndex = (currentIndex + s) % items.length;
    }
    updateMediaPosition();
  }

  if (prevArrow) prevArrow.addEventListener('click', (e) => { e.stopPropagation(); handleArrowClick('left'); });
  if (nextArrow) nextArrow.addEventListener('click', (e) => { e.stopPropagation(); handleArrowClick('right'); });
  // Also stop clicks anywhere on the nav container from triggering the gallery's click handler
  var navEl = document.getElementById('image-navigation');
  if (navEl) navEl.addEventListener('click', (e) => e.stopPropagation());

  // Show pair navigation UI on desktop when more than one pair exists
  function refreshNavVisibility() {
    var nav = document.getElementById('image-navigation');
    if (!nav) return;
    var s = step();
    var pairCount = Math.ceil(items.length / s);
    if (window.matchMedia('(min-width: 749px)').matches && pairCount > 1) {
      nav.classList.add('has-multiple-pairs');
    } else {
      nav.classList.remove('has-multiple-pairs');
    }
  }
  refreshNavVisibility();
  window.addEventListener('resize', function() {
    // Recreate dots and refresh visibility on resize (step changes between mobile/desktop)
    createDots();
    refreshNavVisibility();
    updateMediaPosition();
  });

  function isTouchDevice() {
    return ('ontouchstart' in window || navigator.maxTouchPoints > 0 || navigator.msMaxTouchPoints > 0);
  }

  // Image click opens the lightbox (arrows/dots still navigate the carousel)
  gallery.addEventListener('click', function(event) {
    // Let arrow/dot clicks fall through to their own handlers
    if (event.target.closest('.image-navigation')) return;
    var clickedImg = event.target.closest('.product__item-img');
    if (clickedImg) {
      openLightbox(clickedImg.src, clickedImg.alt);
    }
  });

  if (isTouchDevice()) {
    let touchstartX = 0;
    let touchendX = 0;
    gallery.addEventListener('touchstart', function(evt) {
      touchstartX = evt.touches[0].clientX;
    }, false);

    gallery.addEventListener('touchmove', function(evt) {
      touchendX = evt.touches[0].clientX;
    }, false);

    gallery.addEventListener('touchend', function(evt) {
      if (touchendX < touchstartX - 50) {
        handleSwipe('left');
      } else if (touchendX > touchstartX + 50) {
        handleSwipe('right');
      }
    }, false);
  }

  const cursorLeft = "url('{% if settings.image-switches == 'black' %}{{ 'arrow-left.svg' | asset_url | image_url: '32x32' }}{% elsif settings.image-switches == 'white' %}{{ 'arrow-left-white.svg' | asset_url | image_url: '32x32' }}{% endif %}'), auto";
  const cursorRight = "url('{% if settings.image-switches == 'black' %}{{ 'arrow-right.svg' | asset_url | image_url: '32x32' }}{% elsif settings.image-switches == 'white' %}{{ 'arrow-right-white.svg' | asset_url | image_url: '32x32' }}{% endif %}'), auto";

  createDots();
  updateMediaPosition();

  items.forEach((item) => {
    item.addEventListener('mousemove', function(event) {
      updateCursor(this);
    });
  });

  function updateCursor(itemElement) {
    // Magnifying-glass cursor hints that images are clickable to open the lightbox
    itemElement.style.cursor = 'zoom-in';
    return;
    if (items.length > 1) {
      const rect = itemElement.getBoundingClientRect();
      const x = event.clientX - rect.left;
      itemElement.style.cursor = x < rect.width / 2 ? cursorLeft : cursorRight;
    } else {
      itemElement.style.cursor = "auto";
    }
  }

  // Find the matching variant based on ALL currently-selected option buttons,
  // then swap the gallery image. Works no matter which position color/size sits in.
  function getSelectedOptionValues() {
    const selected = {};
    document.querySelectorAll('.option-value.active').forEach(btn => {
      const pos = btn.getAttribute('data-option');
      const val = btn.getAttribute('data-value');
      selected[`option${pos}`] = val;
    });
    return selected;
  }

  function findVariantFromSelection() {
    const selected = getSelectedOptionValues();
    return productVariants.find(v =>
      Object.keys(selected).every(k => v[k] === selected[k])
    );
  }

  const variantButtons = document.querySelectorAll('.option-value');
  variantButtons.forEach(button => {
    button.addEventListener('click', function() {
      // theme.liquid's handler runs first and updates `.active` classes.
      // Defer one tick so our read of active buttons sees the new state.
      setTimeout(() => {
        const selectedVariant = findVariantFromSelection();
        if (selectedVariant) {
          scrollToVariantMedia(selectedVariant);
        }
      }, 0);
    });
  });

  updateMediaPosition();

});
</script>
<script>
  document.querySelectorAll('table').forEach(function(table) {
  var wrapper = document.createElement('div');
  wrapper.classList.add('product-table');

  table.parentNode.insertBefore(wrapper, table);

  wrapper.appendChild(table);
});

</script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    function setProductInfoHeight() {
      var productInfo = document.querySelector('.product-info');
      if (productInfo) productInfo.style.height = '';
      // Report actual header and sticky-footer heights to CSS so the wrapper
      // can vertically center content in the remaining viewport.
      var header = document.getElementById('shopify-section-header');
      var stickyFooter = document.querySelector('.sticky-site-footer');
      var root = document.documentElement;
      root.style.setProperty('--product-header-h', (header ? header.offsetHeight : 120) + 'px');
      root.style.setProperty('--product-footer-h', (stickyFooter ? stickyFooter.offsetHeight : 100) + 'px');
    }

    // Auto-fit product title on one line — starts at 42px, shrinks to fit
    function fitProductTitle() {
      var title = document.querySelector('.product-info__title--above');
      if (!title) return;
      // Mobile used to opt out of auto-fit and sit at a flat 21px. It now fits
      // the same way desktop does, just from a smaller ceiling, so short titles
      // get bigger while a long one shrinks instead of wrapping.
      var isDesktop = window.matchMedia('(min-width: 749px)').matches;
      var maxSize = isDesktop ? 42 : 26;
      var minSize = isDesktop ? 16 : 17;
      var parentWidth = title.parentElement.clientWidth;
      title.style.fontSize = maxSize + 'px';
      var size = maxSize;
      while (title.scrollWidth > parentWidth && size > minSize) {
        size -= 1;
        title.style.fontSize = size + 'px';
      }
    }

    fitProductTitle();
    setProductInfoHeight();

    window.addEventListener('resize', function() {
      fitProductTitle();
      setProductInfoHeight();
    });
    // Also re-run after images and sticky footer paint so heights are accurate
    window.addEventListener('load', function() {
      fitProductTitle();
      setProductInfoHeight();
    });
  });
</script>

