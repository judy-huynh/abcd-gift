<style>
  /* ── Blog Layout ── */
  .blog-page {
    width: 100%;
    max-width: 1200px;
    margin: 3rem auto 4rem;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .blog-header {
    margin-bottom: 2.5rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .blog-title {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin: 0;
    opacity: 0.5;
  }

  /* ── Tag Filter ── */
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
  }

  .blog-tag {
    font-size: 9px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    opacity: 0.4;
    font-weight: 600;
    padding: 4px 10px;
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 2px;
    transition: all 0.2s;
  }

  .blog-tag:hover,
  .blog-tag--active {
    background: #000;
    color: #fff;
    border-color: #000;
    opacity: 1;
  }

  /* ── Featured / Hero Post ── */
  .blog-hero {
    margin-bottom: 3rem;
  }

  .blog-hero .hero-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    border-radius: 2px;
  }

  .hero-card__image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f2f2f2;
  }

  .hero-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .blog-hero .hero-card:hover .hero-card__image img {
    transform: scale(1.03);
  }

  .hero-card__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 3rem;
    background: #f8f8f6;
  }

  .hero-card__label {
    font-size: 10px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    opacity: 0.45;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .hero-card__title {
    font-size: 32px;
    line-height: 1.2;
    margin: 0 0 1rem;
    font-weight: 700;
    letter-spacing: -0.3px;
  }

  .hero-card__excerpt {
    font-size: 15px;
    line-height: 1.65;
    margin: 0 0 1.5rem;
    opacity: 0.65;
    max-width: 420px;
  }

  .hero-card__meta {
    font-size: 12px;
    opacity: 0.4;
    letter-spacing: 0.3px;
  }

  /* ── Post Grid ── */
  .blog-grid-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    opacity: 0.35;
    margin-bottom: 1.25rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .post-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .post-card__image {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #f2f2f2;
    border-radius: 2px;
    margin-bottom: 1rem;
  }

  .post-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .post-card:hover .post-card__image img {
    transform: scale(1.04);
  }

  .post-card__tag {
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    opacity: 0.4;
    margin-bottom: 0.4rem;
    font-weight: 600;
  }

  .post-card__title {
    font-size: 20px;
    line-height: 1.3;
    margin: 0 0 0.6rem;
    font-weight: 600;
    letter-spacing: -0.2px;
  }

  .post-card__excerpt {
    font-size: 14px;
    line-height: 1.55;
    margin: 0 0 0.75rem;
    opacity: 0.55;
    flex-grow: 1;
  }

  .post-card__meta {
    font-size: 11px;
    opacity: 0.35;
    letter-spacing: 0.3px;
  }

  /* ── Empty State ── */
  .blog-empty {
    text-align: center;
    padding: 4rem 2rem;
    opacity: 0.5;
    font-size: 14px;
  }

  /* ── Pagination ── */
  .blog-pagination {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(0,0,0,0.08);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .blog-pagination a {
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
    color: inherit;
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  .blog-pagination a:hover {
    opacity: 1;
  }

  .blog-pagination__current {
    font-size: 12px;
    opacity: 0.3;
  }

  /* ── Responsive ── */
  @media screen and (max-width: 999px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .hero-card__content {
      padding: 2rem;
    }

    .hero-card__title {
      font-size: 26px;
    }
  }

  @media screen and (max-width: 749px) {
    .blog-page {
      padding: 0 16px;
      margin-top: 2rem;
    }

    .blog-hero .hero-card {
      grid-template-columns: 1fr;
    }

    .hero-card__image {
      aspect-ratio: 16 / 9;
    }

    .hero-card__content {
      padding: 1.5rem;
    }

    .hero-card__title {
      font-size: 24px;
    }

    .blog-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .post-card__title {
      font-size: 18px;
    }

    .blog-header {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>

<div class="blog-page">
  <header class="blog-header">
    <h1 class="blog-title">{{ blog.title | escape }}</h1>
  </header>

  {% paginate blog.articles by 13 %}
    {% if blog.articles.size > 0 %}

      {%- comment -%} ── Hero: first post gets featured treatment ── {%- endcomment -%}
      {% assign hero = blog.articles.first %}
      {% if paginate.current_page == 1 %}
        <section class="blog-hero">
          <a class="hero-card" href="{{ hero.url }}">
            {% if hero.image %}
              <div class="hero-card__image">
                <img
                  src="{{ hero.image | img_url: '900x675', crop: 'center' }}"
                  alt="{{ hero.image.alt | default: hero.title | escape }}"
                  loading="eager"
                  width="900" height="675">
              </div>
            {% endif %}
            <div class="hero-card__content">
              <span class="hero-card__label">Latest</span>
              <h2 class="hero-card__title">{{ hero.title }}</h2>
              <p class="hero-card__excerpt">{{ hero.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
              <span class="hero-card__meta">{{ hero.published_at | date: "%B %-d, %Y" }}{% if hero.author != blank %} · {{ hero.author }}{% endif %}</span>
            </div>
          </a>
        </section>
      {% endif %}

      {%- comment -%} ── Grid: remaining posts ── {%- endcomment -%}
      {% if blog.articles.size > 1 or paginate.current_page > 1 %}
        <section>
          {% if paginate.current_page == 1 %}
            <p class="blog-grid-label">More posts</p>
          {% endif %}
          <div class="blog-grid">
            {% for article in blog.articles %}
              {% if paginate.current_page == 1 and forloop.first %}
                {% continue %}
              {% endif %}

              <a class="post-card" href="{{ article.url }}">
                {% if article.image %}
                  <div class="post-card__image">
                    <img
                      src="{{ article.image | img_url: '600x400', crop: 'center' }}"
                      alt="{{ article.image.alt | default: article.title | escape }}"
                      loading="lazy"
                      width="600" height="400">
                  </div>
                {% endif %}

                {%- assign card_tag = '' -%}
                {%- for tag in article.tags -%}
                  {%- unless tag contains 'shop:' -%}
                    {%- if card_tag == '' -%}{%- assign card_tag = tag -%}{%- endif -%}
                  {%- endunless -%}
                {%- endfor -%}
                {% if card_tag != '' %}
                  <span class="post-card__tag">{{ card_tag }}</span>
                {% endif %}

                <h3 class="post-card__title">{{ article.title }}</h3>

                <p class="post-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>

                <span class="post-card__meta">{{ article.published_at | date: "%B %-d, %Y" }}</span>
              </a>
            {% endfor %}
          </div>
        </section>
      {% endif %}

    {% else %}
      <div class="blog-empty">
        <p>No posts yet — check back soon.</p>
      </div>
    {% endif %}

    {% if paginate.pages > 1 %}
      <nav class="blog-pagination" aria-label="Pagination">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}">← Newer</a>
        {% endif %}
        <span class="blog-pagination__current">{{ paginate.current_page }} / {{ paginate.pages }}</span>
        {% if paginate.next %}
          <a href="{{ paginate.next.url }}">Older →</a>
        {% endif %}
      </nav>
    {% endif %}
  {% endpaginate %}

  {% if blog.all_tags.size > 0 %}
    <nav class="blog-tags" aria-label="Filter by topic" style="margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(0,0,0,0.06); justify-content: center;">
      <a class="blog-tag {% unless current_tags %}blog-tag--active{% endunless %}" href="{{ blog.url }}">All</a>
      {% for tag in blog.all_tags %}
        <a class="blog-tag {% if current_tags contains tag %}blog-tag--active{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>
      {% endfor %}
    </nav>
  {% endif %}
</div>
