{% doc %}
  @prompt
    Recreate the "Footer with logo" block for the footer section. It should include an image picker setting for the logo (so the merchant can select their SVG logo file), along with logo width settings for desktop and mobile, logo color option, padding, and background color settings. The block should display the selected logo image prominently in the footer.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-logo-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
  }

  .ai-footer-logo__wrapper-{{ ai_gen_id }} {
    display: inline-block;
    max-width: 100%;
  }

  .ai-footer-logo__image-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.logo_width_desktop }}px;
    height: auto;
    max-width: 100%;
  }

  .ai-footer-logo__placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.logo_width_desktop }}px;
    max-width: 100%;
    height: 80px;
    background-color: #f4f4f4;
    border-radius: 4px;
  }

  .ai-footer-logo__placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-footer-logo__empty-state-{{ ai_gen_id }} {
    margin-top: 12px;
    font-size: 14px;
    color: #666;
  }

  {% if block.settings.logo_color_enabled %}
    .ai-footer-logo__image-{{ ai_gen_id }} {
      filter: brightness(0) saturate(100%) {{ block.settings.logo_color | color_to_rgb | replace: 'rgb(', '' | replace: ')', '' | split: ',' | first | times: 0.2126 | plus: block.settings.logo_color | color_to_rgb | replace: 'rgb(', '' | replace: ')', '' | split: ',' | offset: 1 | first | times: 0.7152 | plus: block.settings.logo_color | color_to_rgb | replace: 'rgb(', '' | replace: ')', '' | split: ',' | last | times: 0.0722 | divided_by: 255.0 | times: 100 }}%;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-footer-logo-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
    }

    .ai-footer-logo__image-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width_mobile }}px;
    }

    .ai-footer-logo__placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width_mobile }}px;
      height: 60px;
    }

    .ai-footer-logo__placeholder-{{ ai_gen_id }} svg {
      width: 40px;
      height: 40px;
    }
  }
{% endstyle %}

<div class="ai-footer-logo-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-logo__wrapper-{{ ai_gen_id }}">
    {% if block.settings.logo %}
      <img
        src="{{ block.settings.logo | image_url: width: 800 }}"
        alt="{{ shop.name }}"
        class="ai-footer-logo__image-{{ ai_gen_id }}"
        width="{{ block.settings.logo_width_desktop }}"
        height="auto"
        loading="lazy"
      >
    {% else %}
      <div class="ai-footer-logo__placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
      <div class="ai-footer-logo__empty-state-{{ ai_gen_id }}">
        Add your logo
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Footer with logo",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width_desktop",
      "label": "Desktop width",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Mobile width",
      "min": 40,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "checkbox",
      "id": "logo_color_enabled",
      "label": "Enable logo color override",
      "default": false
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Logo color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Padding mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "label": "Horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Footer with logo"
    }
  ]
}
{% endschema %}
